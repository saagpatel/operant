{
	"name": "saagar-operant-mcp",
	"version": "0.1.1",
	"packageManager": "npm@11.13.0",
	"engines": {
		"node": ">=24.17.0 <25"
	},
	"mcpName": "io.github.saagpatel/operant-mcp",
	"type": "module",
	"description": "Read-only OPERANT benchmark MCP with explicit research-integrity boundaries.",
	"license": "MIT",
	"author": "Saagar Patel",
	"homepage": "https://operant.saagarpatel.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/saagpatel/operant.git"
	},
	"bugs": {
		"url": "https://github.com/saagpatel/operant/issues"
	},
	"keywords": [
		"mcp",
		"model-context-protocol",
		"mcp-server",
		"ai-agents",
		"benchmark",
		"operant",
		"calibration",
		"cloudflare-workers",
		"stdio"
	],
	"scripts": {
		"build:corpus": "node scripts/build-corpus.mjs",
		"build:cli": "esbuild src/stdio.ts --bundle --platform=node --format=esm --outfile=dist/stdio.js",
		"build:wellknown": "node scripts/build-wellknown.mjs",
		"sign:manifest": "mcp-kit-sign sign --manifest=.well-known/mcp.json --key=.signing/operant-ed25519.key",
		"verify:manifest": "mcp-kit-sign verify --manifest=.well-known/mcp.json",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"probe:mcp": "node scripts/probe-mcp.mjs",
		"parity": "mcp-kit-parity",
		"dev": "wrangler dev",
		"deploy": "wrangler deploy"
	},
	"bin": {
		"saagar-operant-mcp": "dist/stdio.js"
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.32.2",
		"zod": "^4"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5",
		"esbuild": "0.28.2",
		"saagar-mcp-kit": "^0.1.0",
		"typescript": "^7",
		"vite": "8.3.5",
		"vitest": "5.0.3",
		"wrangler": "^4"
	},
